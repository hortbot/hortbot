package templates

import (
	"github.com/hortbot/hortbot/internal/db/dbsql"
	"github.com/hortbot/hortbot/internal/db/dbsql"
)

func displayNameFor(channel *dbsql.Channel) string {
	if channel.DisplayName != "" {
		return channel.DisplayName
	}
	return channel.Name
}

func publicDisplayName(channel dbsql.ListPublicActiveChannelsRow) string {
	if channel.DisplayName != "" {
		return channel.DisplayName
	}
	return channel.Name
}

templ channelsBody(channels []dbsql.ListPublicActiveChannelsRow) {
	<section class="section">
		<div class="container">
			<h1 class="title has-text-centered">
				Channels
			</h1>
			<div class="columns">
				<div class="column is-8 is-offset-2">
					<div class="list">
						for _, channel := range channels {
							<a class="list-item" href={ channelURL(channel.Name) }>{ publicDisplayName(channel) }</a>
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ ChannelsPage(channels []dbsql.ListPublicActiveChannelsRow) {
	@SimplePage("Channels") {
		@channelsBody(channels)
	}
}
